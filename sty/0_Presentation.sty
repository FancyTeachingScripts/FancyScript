% Timer- und Outline-Farben, abhängig vom hellen Modus:
% im dunklen Modus wie bisher (dunkler Balken, weisser Text), im hellen
% Modus heller Balken mit schwarzem Text bzw. weisser (unsichtbarer) Outline.
\ifbright
  \newcommand{\timerbarfull}{black!20}
  \newcommand{\timerbarcover}{black!20}
  \newcommand{\timertextcolor}{black}
  \newcommand{\outlinecolor}{white}
\else
  \newcommand{\timerbarfull}{darkgray!120}
  \newcommand{\timerbarcover}{darkgray!100}
  \newcommand{\timertextcolor}{white}
  \newcommand{\outlinecolor}{black}
\fi

\renewcommand{\timer}[1]{
    \iftimer
        \iftoggle{preview}{
            }{%
            \begin{tikzpicture}[remember picture, overlay]
                \pgfmathtruncatemacro{\total}{#1} % total number of blocks (steps)
                \pgfmathtruncatemacro{\lastTimer}{\total + 1} % total number of blocks (steps)
                \pgfmathtruncatemacro{\lastSlide}{\total + 2} % total number of blocks (steps)
                \pgfmathsetmacro{\blockwidth}{\paperwidth / \total}
                
                
                \only<1>{%
                    \fill[\timerbarfull] (current page.south west) rectangle ++(\paperwidth, 0.31cm);
                    \node[text width=2.1cm, text=\timertextcolor] at ([yshift=4.5pt]current page.south east) {\fontsize{8}{8}\selectfont\total~Min.};
                }
        
                \foreach \i in {2,...,\lastSlide} {
                    \pgfmathsetmacro{\x}{(\i-2)*\blockwidth}
                    \pgfmathsetmacro{\gWidth}{(\lastSlide - \i)*\blockwidth}
                    \pgfmathtruncatemacro{\timeleft}{\lastSlide - \i}
                    \only<\i>{%
                        \ifnum\i<\lastSlide
                            \fill[left color = green,right color = orange] ([xshift=0cm ]current page.south west) rectangle ++(\paperwidth, 0.3cm);
                            \fill[\timerbarcover] ([xshift=\x ]current page.south west) rectangle ++(\paperwidth, 0.31cm);
                            \node[text width=2.1cm, text=\timertextcolor] at ([yshift=4.5pt]current page.south east) {\fontsize{8}{8}\selectfont \timeleft~Min.};
                        \fi
                    }
                    \ifnum\i<\lastSlide\transduration<\i>{60}\fi
                }
            \end{tikzpicture}%
            }
    \fi
}


\newcommand{\fullframe}[1]{
\makebox[\linewidth][c]{%
  \begin{minipage}{\paperwidth}
    \raggedright#1
  \end{minipage}%
  }%
}


\renewcommand{\EndOfSession}[1]{
    \begin{frame}[plain,label=end]
        \fullframe{\animategraphics[autoplay,loop,width=\paperwidth]{#1}{sty/frames/frame-}{000}{125}}    
    \end{frame}
}


